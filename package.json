{
  "name": "glance",
  "private": true,
  "version": "1.0.0",
  "description": "Glance: a fast, private Markdown live-preview editor that runs entirely in the browser, with GFM, KaTeX math, Mermaid diagrams, HTML/PDF export, and shareable links.",
  "homepage": "https://glance.eidoriantan.com",
  "bugs": "https://github.com/eidoriantan/glance/issues",
  "license": "MIT",
  "author": {
    "name": "Adriane Justine Tan",
    "email": "me@eidoriantan.com",
    "url": "https://eidoriantan.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidoriantan/glance.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
